    },
    "description": "List which nodes sell what, one keyset page at a time (listingId ascending), optionally narrowed to one node (nodeId) and/or one catalogue item (catalogItemId). Each listing says whether it is LIVE or SUPPRESSED (with the reason: NODE_NOT_SELLABLE or DISCONTINUED) and the availability a vendor's feed last gave it (availableQty, the vendor's basis, asOf and the feedId). Pass the returned nextCursor as after to get the next page. Read-only; a bad limit fails with validation-failed.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "description": "the previous page's nextCursor; optional, omitted means the first page",
          "type": "string"
        },
        "catalogItemId": {
          "description": "keep only the listings of this catalogue item; optional, omitted means every item",
          "type": "string"
        },
        "limit": {
          "description": "page size, 1..500; optional, omitted or 0 means the default page size (100)",
          "type": "integer"
        },
        "nodeId": {
          "description": "keep only the listings of this node; optional, omitted means every node",
          "type": "string"
        }
      },
      "type": "object"
    },
